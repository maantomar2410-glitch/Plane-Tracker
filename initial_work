import math
import matplotlib.pyplot as plt
WAYPOINTS = [
    ("ANOLI",  19.15,   72.87,   2100),
    ("XOPAL",  19.80,   72.90,   4572),
    ("KAMOL",  20.80,   73.10,   7620),
    ("ASOGA",  21.90,   73.50,  10668),
    ("OPULA",  23.00,   73.80,  10668),
    ("GIRDA",  24.50,   74.50,  10668),
    ("SAVLA",  26.00,   75.20,  10668),
    ("MAKOL",  27.20,   76.00,  10668),
    ("NIKAD",  27.80,   76.50,   4000),
    ("IGARI",  28.30,   76.90,   1500),
    ("VIDP",   28.5665, 77.1031,    0),
]

class Aircraft:
    def __init__(self, M, F):
        self.M        = M
        self.F        = F
        self.t        = 0
        self.rho_ini  = 1.225
        self.height   = 0
        self.u        = 2.8      # kg/s fuel burn at sea level (corrected)
        self.v        = 0
        self.A        = 122.4
        self.g        = 9.81
        self.lat      = 18.8975
        self.lon      = 72.8744
        self.heading  = 358.7

    def get_rho(self):
        return self.rho_ini * (1 - 0.000022 * self.height) ** 4.2559

    def speed_of_sound(self):
        T = max(288.15 - 0.0065 * self.height, 216.65)
        return math.sqrt(1.4 * 287 * T)

    def get_thrust(self, throttle):
        rho          = self.get_rho()
        thrust_lapse = (rho / self.rho_ini) ** 0.8
        return self.F * throttle * thrust_lapse

    def get_vx_limit(self):
        if self.height < 3048:
            return 128.6                        # 250kt below 10000ft
        elif self.height < 4000:
                                                # gradual acceleration 10000ft -> 13000ft
            ratio = (self.height - 3048) / (4000 - 3048)
            return 128.6 + ratio * (231.0 - 128.6)
        else:
            return 231.0                        # Mach 0.78 cruise speed

    def get_aero_coefficients(self, alpha, v):
        if  v < 85:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.045, 1.0,  5.2, 0.050, 2.5
        elif v < 95:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.035, 0.8,  5.4, 0.048, 2.2
        elif v < 105:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.025, 0.55, 5.6, 0.046, 1.9
        else:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.0175, 0.25, 5.7, 0.045, 1.5

        Cl = min(Cl0 + Cl_a * alpha, Cl_max)

        mach = v / self.speed_of_sound()
        if mach > 0.3:
            PG = 1 / math.sqrt(max(1 - mach**2, 0.01))
            Cl = min(Cl * PG, Cl_max)
        if mach > 0.75:
            Cd0 += 20 * (mach - 0.75) ** 4

        Cd = Cd0 + k * Cl**2
        return Cl, Cd, mach


    def update_position(self, dist_m, heading_deg):
        R   = 6371000
        hdg = math.radians(heading_deg)
        d_lat = (dist_m * math.cos(hdg)) / R
        d_lon = (dist_m * math.sin(hdg)) / (
                 R * math.cos(math.radians(self.lat)))
        self.lat += math.degrees(d_lat)
        self.lon += math.degrees(d_lon)

    def get_bearing(self, target_lat, target_lon):
        lat1 = math.radians(self.lat)
        lat2 = math.radians(target_lat)
        dlon = math.radians(target_lon - self.lon)
        x    = math.sin(dlon) * math.cos(lat2)
        y    = (math.cos(lat1) * math.sin(lat2) -
                math.sin(lat1) * math.cos(lat2) * math.cos(dlon))
        return (math.degrees(math.atan2(x, y)) + 360) % 360

    def get_bank_angle(self, target_heading):
        error = target_heading - self.heading

        if error > 180:
            error = error - 360
        if error < -180:
            error = error + 360

        if self.height < 120:
            return 0

        if abs(error) < 5:
            return 0

        if self.height < 300:
            bank = 15      # gentle bank below 1000ft
        else:
            bank = 25      # standard bank above 1000ft

        #  bank right if target is clockwise, left if anticlockwise
        if error > 0:
            return bank
        else:
            return -bank



    def takeoff(self):
        dt         = 0.01
        Crr        = 0.030
        spool_time = 10.0
        F_takeoff  = 200000      # derated flex thrust at BOM

        alpha_ground = math.radians(4)
        Cl = min(0.5 + 5.2 * alpha_ground, 2.5)
        Cd = 0.08 + 0.05 * Cl**2

        Vr     = ((2 * self.M * self.g) /
                  (self.rho_ini * 1.54 * self.A)) ** 0.5
        runway = 0

        while self.v < Vr:
            if self.t < spool_time:
                thrust = F_takeoff * (0.07 + 0.93 * (self.t / spool_time))
            else:
                thrust = F_takeoff

            lift     = 0.5 * self.rho_ini * self.v**2 * Cl * self.A
            drag     = 0.5 * self.rho_ini * self.v**2 * Cd * self.A
            N        = self.M * self.g - lift
            friction = Crr * N
            acc      = (thrust - drag - friction) / self.M

            self.v  += acc * dt
            runway  += self.v * dt
            self.t  += dt
            self.M  -= self.u * dt

            print(f"[TAKEOFF DONE]")
            print(f"  Vr     = {self.v:.1f} m/s ({self.v*1.944:.0f} knots)")
            print(f"  Runway = {runway:.0f} m")
            print(f"  Time   = {self.t:.1f} s")
            return [self.v, self.M, self.t, runway]

    def initial_climb(self, theta=15, manual_ceil=305):  # manual climbing
        ans      = self.takeoff()
        Vx, M, t = ans[0], ans[1], ans[2]
        dt       = 0.01
        Vy       = 0
        dist     = 0
        angle    = 11.5  # pitch angle just after lift

        while self.height < manual_ceil:
            rho   = self.get_rho()
            v     = math.sqrt(Vx**2 + Vy**2)
            gamma = math.atan2(Vy, Vx)
            alpha = math.radians(angle) - gamma

            Cl, Cd, mach = self.get_aero_coefficients(alpha, v)
            thrust = self.get_thrust(throttle=1.0)

            target_heading = self.get_bearing(*WAYPOINTS[0][1:3])
            phi_deg = self.get_bank_angle(target_heading)
            phi     = math.radians(abs(phi_deg))
            if phi > 0 :
                n = 1 / math.cos(phi)
            else:
                n=1.0


            heading_error = target_heading - self.heading
            if heading_error > 180:
                heading_error -= 360
            if heading_error < -180:
                heading_error += 360

            if phi > 0:
                omega     = self.g * math.tan(phi) / max(v, 1.0)   # rad/s
                rate_deg  = math.degrees(omega)
                turn_step = min(abs(heading_error), rate_deg * dt)
            else:
                turn_step = 0

            self.heading = (self.heading +
                math.copysign(turn_step, heading_error) + 360) % 360

            Cl_turn = min(Cl * n, 2.2)
            Cd_turn = 0.035 + 0.048 * Cl_turn**2


            L = 0.5 * rho * v**2 * Cl_turn * self.A
            D = 0.5 * rho * v**2 * Cd_turn * self.A
            sine = math.sin(math.radians(angle))
            cos  = math.cos(math.radians(angle))
            acc_x = (thrust*cos - L*math.sin(gamma) - D*math.cos(gamma)) / M
            acc_y = (thrust*sine + L*math.cos(gamma)/n
                     - M*self.g - D*math.sin(gamma)) / M
            Vx_new = Vx + acc_x * dt
            Vy_new = Vy + acc_y * dt

            if Vx_new > self.get_vx_limit():
                Vx_new = self.get_vx_limit()
            Vx = Vx_new
            Vy = Vy_new
            self.height += Vy * dt
            dist        += Vx * dt

            t += dt
            M -= self.u * (rho / self.rho_ini)**0.85 * dt

            if angle < theta:
                angle += 0.02
            

