class Aircraft:
    def __init__(self, M, F):
        self.M        = M
        self.F        = F
        self.t        = 0
        self.rho_ini  = 1.225
        self.height   = 0
        self.u        = 2.8      # kg/s fuel burn at sea level (corrected)
        self.v        = 0
        self.A        = 122.4
        self.g        = 9.81
        self.lat      = 18.8975
        self.lon      = 72.8744
        self.heading  = 358.7

    def get_rho(self):
        return self.rho_ini * (1 - 0.000022 * self.height) ** 4.2559

    def speed_of_sound(self):
        T = max(288.15 - 0.0065 * self.height, 216.65)
        return math.sqrt(1.4 * 287 * T)

    def get_thrust(self, throttle):
        rho          = self.get_rho()
        thrust_lapse = (rho / self.rho_ini) ** 0.8
        return self.F * throttle * thrust_lapse

    def get_aero_coefficients(self, alpha, v):
        if  v < 85:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.045, 1.0,  5.2, 0.050, 2.5
        elif v < 95:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.035, 0.8,  5.4, 0.048, 2.2
        elif v < 105:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.025, 0.55, 5.6, 0.046, 1.9
        else:
            Cd0, Cl0, Cl_a, k, Cl_max = 0.0175, 0.25, 5.7, 0.045, 1.5

        Cl = min(Cl0 + Cl_a * alpha, Cl_max)

        mach = v / self.speed_of_sound()
        if mach > 0.3:
            PG = 1 / math.sqrt(max(1 - mach**2, 0.01))
            Cl = min(Cl * PG, Cl_max)
        if mach > 0.75:
            Cd0 += 20 * (mach - 0.75) ** 4

        Cd = Cd0 + k * Cl**2
        return Cl, Cd, mach



    def takeoff(self):
        dt         = 0.01
        Crr        = 0.030
        spool_time = 10.0
        F_takeoff  = 200000      # derated flex thrust at BOM

        alpha_ground = math.radians(4)
        Cl = min(0.5 + 5.2 * alpha_ground, 2.5)
        Cd = 0.08 + 0.05 * Cl**2

        Vr     = ((2 * self.M * self.g) /
                  (self.rho_ini * 1.54 * self.A)) ** 0.5
        runway = 0

        while self.v < Vr:
            if self.t < spool_time:
                thrust = F_takeoff * (0.07 + 0.93 * (self.t / spool_time))
            else:
                thrust = F_takeoff

            lift     = 0.5 * self.rho_ini * self.v**2 * Cl * self.A
            drag     = 0.5 * self.rho_ini * self.v**2 * Cd * self.A
            N        = self.M * self.g - lift
            friction = Crr * N
            acc      = (thrust - drag - friction) / self.M

            self.v  += acc * dt
            runway  += self.v * dt
            self.t  += dt
            self.M  -= self.u * dt

            print(f"[TAKEOFF DONE]")
            print(f"  Vr     = {self.v:.1f} m/s ({self.v*1.944:.0f} knots)")
            print(f"  Runway = {runway:.0f} m")
            print(f"  Time   = {self.t:.1f} s")
            return [self.v, self.M, self.t, runway]

    def initial_climb(self, theta=15, manual_ceil=305):  # manual climbing
        ans      = self.takeoff()
        Vx, M, t = ans[0], ans[1], ans[2]
        dt       = 0.01
        Vy       = 0
        dist     = 0
        angle    = 11.5  # pitch angle just after lift

        while self.height < manual_ceil:
            rho   = self.get_rho()
            v     = math.sqrt(Vx**2 + Vy**2)
            gamma = math.atan2(Vy, Vx)
            alpha = math.radians(angle) - gamma

            Cl, Cd, mach = self.get_aero_coefficients(alpha, v)
            thrust = self.get_thrust(throttle=1.0)
